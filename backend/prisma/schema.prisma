generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String?  @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns       Campaign[]
  senders         Sender[]
  emails          Email[]
  slackConnection SlackConnection?

  @@index([googleId])
  @@index([createdAt])
}

model Campaign {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  name                 String?
  subject              String
  body                 String
  startTime            DateTime
  delayBetweenEmailsMs Int
  hourlyLimit          Int
  status               CampaignStatus @default(ACTIVE)

  // Unique identifier for the complete scheduling request.
  // The service will namespace this with the user ID before storing it.
  idempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  @@index([userId, status])
  @@index([startTime])
}

model Sender {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @db.Uuid
  email       String
  displayName String?

  // SMTP credentials will be encrypted before being persisted.
  smtpHost          String
  smtpPort          Int
  smtpUsername      String
  encryptedPassword String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
  @@index([userId, isActive])
}

model Email {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  userId     String @db.Uuid
  senderId   String @db.Uuid

  recipient String
  subject   String
  body      String

  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?

  status EmailStatus @default(SCHEDULED)

  // Stable BullMQ job identity.
  jobId String @unique

  // Worker lifecycle information.
  processingStartedAt DateTime?
  lastError           String?
  attemptCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([campaignId, scheduledAt])
  @@index([senderId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @unique @db.Uuid
  teamId               String?
  teamName             String?
  slackUserId          String?
  encryptedAccessToken String

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
